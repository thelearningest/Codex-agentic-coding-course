{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "electron/**/*.ts",
    "shared/**/*.ts",
    "src/renderer/src/components/PracticeProgress.tsx",
    "src/renderer/src/components/PracticeIntroduction.tsx",
    "src/renderer/src/components/PracticeStartPrompt.tsx",
    "src/renderer/src/components/practice-introduction-copy.ts",
    "src/renderer/src/components/PracticeSuccess.tsx",
    "src/renderer/src/components/PortfolioPackageSubmission.tsx",
    "src/renderer/src/components/PortfolioCodexProjectSetup.tsx",
    "src/renderer/src/components/PortfolioReleaseSubmission.tsx",
    "src/renderer/src/components/PracticeReturnAction.tsx",
    "src/renderer/src/components/TeacherMarkdown.tsx",
    "src/renderer/src/components/practice-guide-anchors.ts",
    "src/renderer/src/components/onboarding-tour-rules.ts",
    "src/renderer/src/components/teacher-starter-questions.ts",
    "tests/**/*.ts"
  ]
}
