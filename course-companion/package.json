{
  "name": "course-companion",
  "version": "0.3.0",
  "private": true,
  "description": "Local desktop learning companion for Codex Content Builder Academy",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "npm run build && electron .",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --pretty false",
    "lint": "eslint .",
    "test": "vitest run && npm run test:startup",
    "test:startup": "node --test tests/disposable-practice-workspace.test.mjs tests/macos-startup.test.mjs",
    "test:practice-runtime": "node --experimental-strip-types tests/practice-app-server-runtime.mjs",
    "test:practice-bound-runtime": "node --experimental-strip-types tests/practice-bound-run-runtime.mjs",
    "test:electron": "npm run build && node tests/electron-smoke.mjs && node tests/teacher-chat-electron.mjs && node tests/practice-video-electron.mjs && node tests/practice-review-feedback-electron.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
